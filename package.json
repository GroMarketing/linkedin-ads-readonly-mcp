  "bin": {
    "linkedin-ads": "bin/linkedin-ads.mjs",
    "linkedin-ads-readonly-mcp": "bin/linkedin-ads.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "linkedin ads",
    "linkedin marketing api",
    "linkedin campaign manager",
    "ad analytics",
    "b2b marketing",
    "paid social",
    "reporting",
    "mcp",
