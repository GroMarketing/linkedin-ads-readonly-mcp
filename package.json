{
  "name": "linkedin-ads-readonly-mcp",
  "version": "0.1.0",
  "description": "Read-only LinkedIn Ads (Marketing API) MCP server and CLI: accounts, campaigns, performance, demographics, creatives, lead form counts and targeting, for AI agents and the terminal. Runs locally with your own token.",
