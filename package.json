    "type": "git",
    "url": "git+https://github.com/GroMarketing/linkedin-ads-readonly-mcp.git"
  },
  "homepage": "https://github.com/GroMarketing/linkedin-ads-readonly-mcp#readme",
  "bugs": {
    "url": "https://github.com/GroMarketing/linkedin-ads-readonly-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  }
