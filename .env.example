# Copy to .env (never commit it) or export these in your shell. Read-only scopes are enough.

# A token from a LinkedIn developer app with Advertising API access, scopes r_ads and r_ads_reporting
LINKEDIN_ACCESS_TOKEN=
# Optional: the account used when a command doesn't name one (digits only)
LINKEDIN_AD_ACCOUNT_ID=
# Optional: LinkedIn API version, YYYYMM. Defaults to 202609.
LINKEDIN_API_VERSION=
